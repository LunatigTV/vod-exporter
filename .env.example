# Twitch API App Credentials (from dev.twitch.tv)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# From twitchtokengenerator.com
TWITCH_USER_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# The numerical ID and username of the channel to monitor
BROADCASTER_ID=
BROADCASTER_NAME=

# Your personal Twitch web session cookie (from browser DevTools: Cookies -> auth-token)
TWITCH_AUTH_TOKEN=
